# Role restrita usada pela API — sujeita a RLS (ver docs/DATABASE.md §5.2)
DATABASE_URL=postgresql+asyncpg://agenda360_app:agenda360_app@localhost:5432/agenda360
# Role dona do schema — usada só por Alembic e seed.py, nunca pela API
ADMIN_DATABASE_URL=postgresql+asyncpg://agenda360:agenda360@localhost:5432/agenda360
# Senha aplicada à role agenda360_app pela migration 0001 (CREATE/ALTER ROLE).
# Precisa bater com a senha usada em DATABASE_URL acima. Em produção, gere uma
# senha forte (ex.: openssl rand -base64 24) e não reuse o default de dev.
APP_DB_PASSWORD=agenda360_app
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
